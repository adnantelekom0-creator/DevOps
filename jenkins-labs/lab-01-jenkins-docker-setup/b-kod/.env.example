# İsteğe bağlı: değerleri değiştirmek için cp .env.example .env
# .env yoksa docker-compose.yml'deki varsayılanlar kullanılır. .env git'e eklenmez.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=DevOps2026!
# Jenkins'in kendi adresi (e-posta linkleri ve BUILD_URL için)
JENKINS_URL=http://localhost:18080/
