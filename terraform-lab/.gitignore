# Local .terraform directories
**/.terraform/*
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with secrets, except example/defaults
*.tfvars
!example.tfvars
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# OS & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# AI & Agent internal files
.agents/
.codex/
AGENTS.md
